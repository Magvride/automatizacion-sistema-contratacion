SMTP_TLS=1
# 1 = envía correos de verdad, 0 = solo simula (guarda borradores). También se
# puede activar por CLI con --enviar-correos.
NOTIFICAR_ENVIAR=0
# Plantilla del cuerpo. Campos disponibles: {ordenador}, {contrato}, {centro_costo}.
