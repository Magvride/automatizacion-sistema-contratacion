# === SMTP NOTIFICACIONES (correos a ordenadores sin registros en UISARD) ===
# Acceso por Outlook / Exchange @uis.edu.co
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=Gestion.contratos@uis.edu.co
SMTP_PASS=1129Contratacion
