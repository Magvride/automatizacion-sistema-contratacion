# Copia este archivo a .env y completa las credenciales reales.
# El .env NO se versiona en git.

# ============================================================
# Alfresco (backend MCP/REST, flujo por defecto)
# ============================================================
# URL del servidor Alfresco. Puede ser la raíz o la de Share; el cliente
# recorta "/share/page" automáticamente.
ALFRESCO_URL=https://gesdoc.uis.edu.co
ALFRESCO_USER=
ALFRESCO_PASS=

# basic (por defecto) | ticket | oauth2
ALFRESCO_AUTH_METHOD=basic

# Verificación del certificado TLS. Pon false solo si el certificado es
# autofirmado/interno y confías en la red.
ALFRESCO_VERIFY_SSL=true
# Tiempo máximo por petición (segundos). Bajarlo evita esperas largas cuando
# Alfresco responde con errores transitorios.
ALFRESCO_TIMEOUT=15
# Hilos para verificar contratos en paralelo (1 = secuencial).
ALFRESCO_WORKERS=4

# OAuth2 (solo si ALFRESCO_AUTH_METHOD=oauth2)
#ALFRESCO_OAUTH2_CLIENT_ID=
#ALFRESCO_OAUTH2_CLIENT_SECRET=
#ALFRESCO_OAUTH2_TOKEN_ENDPOINT=
#ALFRESCO_OAUTH2_GRANT_TYPE=client_credentials
#ALFRESCO_OAUTH2_ACCESS_TOKEN=
#ALFRESCO_OAUTH2_REFRESH_TOKEN=

# ============================================================
# Flujo legado con Selenium (opcional, --backend-alfresco selenium)
# ============================================================
ALFRESCO_SHARE_URL=https://gesdoc.uis.edu.co/share/page
ALFRESCO_SHARE_USER=
ALFRESCO_SHARE_PASS=

# Credenciales usadas por uis_login_p1.py
UIS_LOGIN_USER=
UIS_LOGIN_PASS=
UIS_LOGIN_URL=https://www.uis.edu.co/sistemasInformacion/login.seam?josso_back_to=https://www.uis.edu.co/sistemasInformacion/josso_security_check

# Credenciales usadas por UISARD (flujo legado)
UISARD_URL=https://gestion.uis.edu.co/auth/#/auth/login
UISARD_USER=
UISARD_PASS=

# ============================================================
# Notificación por correo a los ordenadores
# ============================================================
# El envío masivo SIEMPRE requiere autorización explícita dentro de la app
# (diálogo "Autorizar envío de correos"). Estas variables solo configuran el
# servidor SMTP.
SMTP_HOST=smtp.uis.edu.co
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1
#NOTIFICAR_ASUNTO=
#NOTIFICAR_PLANTILLA=
